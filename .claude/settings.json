{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run check:*)",
      "Bash(npm run editorconfig:*)",
      "Bash(npm run lint:css:*)",
      "Bash(npm run lint:js:*)",
      "Bash(npx eslint:*)",
      "Bash(npx stylelint:*)",
      "Bash(npx jest:*)",
      "Bash(node scripts/check.js:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed -n:*)"
    ],
    "deny": [
      "Bash(npm run deploy:*)",
      "Bash(rsync:*)",
      "Bash(ssh:*)",
      "Read(./.env)"
    ]
  }
}
