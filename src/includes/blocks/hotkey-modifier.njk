{# Клавиша-модификатор для сочетания поиска: иконка ⌘ на устройствах Apple, Ctrl на остальных.
  Какую показать, решает класс apple-platform на <html> из apple-platform.js. Иконка — command из Lucide (ISC) #}
{% macro modifierKey() -%}
  <span class="hotkey__ctrl">Ctrl</span><span class="hotkey__cmd"><svg class="hotkey__cmd-icon" viewBox="2 2 20 20" aria-hidden="true" focusable="false"><path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3"/></svg><span class="visually-hidden">Command</span></span>
{%- endmacro %}
