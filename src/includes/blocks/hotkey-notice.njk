{# Временная подсказка о смене клавиши поиска (#1407). Показывается до HOTKEY_NOTICE_END из search-hotkey.js, #}
{# потом её нужно удалить вместе с hotkey-notice.js и hotkey-notice.css #}
<div class="hotkey-notice font-theme font-theme--text" id="hotkey-notice" popover>
  <p class="hotkey-notice__text">
    <strong class="hotkey-notice__title font-theme font-theme--code">Новый хоткей для поиска</strong>
    Теперь поиск открывается
    <span class="hotkey-notice__nowrap">по <kbd class="hotkey-notice__keys"><kbd class="hotkey-notice__key"><span class="hotkey__modifier">Ctrl</span></kbd><kbd class="hotkey-notice__key">K</kbd></kbd>,</span>
    а не по «/».
  </p>
  <button
    class="hotkey-notice__close"
    type="button"
    popovertarget="hotkey-notice"
    popovertargetaction="hide"
  >
    <span aria-hidden="true">×</span>
    <span class="visually-hidden">Закрыть подсказку</span>
  </button>
</div>
