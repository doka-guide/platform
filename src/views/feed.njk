<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/" xml:base="{{ meta.url }}">
  <title>{{ meta.title }}</title>
  <subtitle>{{ meta.subtitle }}</subtitle>
  <link href="{{ permalink | absoluteUrl(meta.url) }}" rel="self"/>
  <link href="{{ meta.url }}"/>
  <updated>{{ updated }}</updated>
  <id>{{ meta.url }}</id>
  <author>
    <name>{{ meta.author.name }}</name>
    <email>{{ meta.author.email }}</email>
  </author>
  {%- for post in posts %}
  <entry>
    <title>{{ post.title }}</title>
    <link href="{{ post.url }}"/>
    <updated>{{ post.date }}</updated>
    <id>{{ post.url }}</id>
    {#- Обложка отдаётся полями Media RSS, а не картинкой внутри content:
        читалки вытаскивают первую картинку содержимого в карточку записи
        и показывают её же в тексте — обложка задваивается. Полей два,
        потому что читалки смотрят разные: media:content — «главная картинка
        записи», media:thumbnail — превью для списка. #}
    <media:content url="{{ post.cover }}" medium="image"/>
    <media:thumbnail url="{{ post.cover }}"/>
    {%- if post.content %}
    <content xml:lang="{{ meta.language }}" type="html">{{ post.content }}</content>
    {%- endif %}
  </entry>
  {%- endfor %}
</feed>
